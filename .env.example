MPVM_API_URL=https://srv-siem.local
# MPVM_TOKEN_URL=https://srv-siem.local:3334/connect/token
MPVM_USERNAME=
MPVM_PASSWORD=
MPVM_CLIENT_ID=mpx
MPVM_CLIENT_SECRET=
MPVM_SCOPE=authorization offline_access mpx.api ptkb.api
# MPVM_ACCESS_TOKEN=
MPVM_UTC_OFFSET=+05:00
# Set true only for lab/self-signed TLS.
MPVM_INSECURE=false
MPVM_TIMEOUT=120
MPVM_BACKGROUND_REQUEST_LIMIT=20
MPVM_ASSET_CARD_REQUEST_WORKERS=20
MPVM_ASSET_CARD_REFRESH_WORKERS=10
MPVM_SCAN_POSTPROCESS_WORKERS=10
MPVM_SCAN_ASSET_PROCESS_WORKERS=4
MPVM_SCAN_TARGET_RESOLUTION_WORKERS=3
MPVM_RECONCILIATION_WORKERS=3
MPVM_DOCKER_DYNAMIC_GROUP_ITERATIONS=3
MPVM_DOCKER_DYNAMIC_GROUP_SETTLE_SECONDS=10
MPVM_DOCKER_DYNAMIC_GROUP_TIMEOUT_SECONDS=120
MPVM_DOCKER_DYNAMIC_GROUP_POLL_SECONDS=5
MPVM_DOCKER_DYNAMIC_GROUP_RETENTION_SECONDS=600
MPVM_PASSPORT_DETAIL_WORKERS=10
MPVM_PASSPORT_DETAIL_TTL_HOURS=24
MPVM_ASSET_METADATA_TTL_SECONDS=3600
MPVM_LOG_LEVEL=INFO
MPVM_LOG_DIR=output/logs
MPVM_LOG_MAX_BYTES=104857600
MPVM_LOG_BACKUP_COUNT=10
MPVM_LOG_RETENTION_DAYS=14
MPVM_DEBUG_PAYLOADS=false
MPVM_DEBUG_PAYLOAD_MAX_BYTES=1048576
MPVM_DEBUG_PAYLOAD_RETENTION_HOURS=24
MPVM_DATABASE_URL=postgresql://mpvm:mpvm@postgres:5432/mpvm
MPVM_EXPORTS_DIR=exports
MPVM_AUTOMATION_SCHEDULER_POLL_SECONDS=30
# Optional global webhook; secret is used for X-MPVM-Signature HMAC-SHA256.
MPVM_AUTOMATION_WEBHOOK_URL=
MPVM_AUTOMATION_WEBHOOK_SECRET=
MPVM_COVERAGE_STALE_DAYS=14
# Local application access. On an empty database this creates the first admin.
MPVM_BOOTSTRAP_ADMIN_USERNAME=admin
MPVM_BOOTSTRAP_ADMIN_PASSWORD=
MPVM_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
MPVM_AUTH_SESSION_HOURS=12
# Enable when the application is served over HTTPS.
MPVM_AUTH_COOKIE_SECURE=false
# --- LDAP (corporate directory) login ---------------------------------------
# Local login is always tried first; on failure and only when enabled, the
# credentials are checked against LDAP and the identity is mapped onto a
# regular local user (auto-provisioned on first login).
MPVM_LDAP_ENABLED=false
# Directory endpoint, e.g. ldap://ad.example.local:389 or ldaps://ad.example.local:636
MPVM_LDAP_URL=
# Search base, e.g. DC=example,DC=local
MPVM_LDAP_BASE_DN=
# Optional service account for lookups; empty = anonymous bind.
MPVM_LDAP_BIND_DN=
MPVM_LDAP_BIND_PASSWORD=
# Filter to locate a user; {username} is replaced (escaped) with the login name.
MPVM_LDAP_USER_FILTER=(sAMAccountName={username})
# Attribute used for the local display name.
MPVM_LDAP_DISPLAY_NAME_ATTRIBUTE=displayName
# Optional group; members get the admin role, everyone else gets the default.
MPVM_LDAP_ADMIN_GROUP_DN=
# Role granted to auto-provisioned users when they are not in the admin group.
MPVM_LDAP_DEFAULT_ROLE=viewer
MPVM_LDAP_CONNECT_TIMEOUT_SECONDS=10
