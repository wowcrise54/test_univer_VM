import psycopg
from psycopg.rows import dict_row
from unittest.mock import patch
from app import db
from app.api.schemas import AssetCardPresetQueryRequest
DSN='postgresql://postgres@127.0.0.1/postgres'
with psycopg.connect(DSN, autocommit=True) as c:
    c.execute('CREATE TABLE asset_cards (asset_id text, display_name text, hostname text, ip_address text, fqdn text, os_name text, os_version text, last_seen text)')
    for i in range(103):
        c.execute('INSERT INTO asset_cards VALUES (%s,%s,NULL,NULL,NULL,%s,%s,NULL)', [str(i),f'host-{i:03}', 'Ubuntu', '22.04'])
    c.execute("INSERT INTO asset_cards VALUES ('other','other',NULL,NULL,NULL,'Ubuntu','24.04',NULL), ('unknown','unknown',NULL,NULL,NULL,'Ubuntu',NULL,NULL), ('empty','empty',NULL,NULL,NULL,'Ubuntu','',NULL)")
    c.execute('CREATE TABLE asset_card_software_inventory (asset_id text, entity_path text, soft_name text, soft_name_normalized text, soft_version text, soft_version_normalized text, vendor text, architecture text, install_path text, is_windows boolean)')
    c.execute("INSERT INTO asset_card_software_inventory VALUES ('0','asset.Host.Softs[0]','app','app','1','1','Microsoft',NULL,NULL,FALSE)")
with patch.object(db,'init_db'), patch.object(db,'asset_card_search_index_coverage',return_value={}), patch.object(db,'connect',side_effect=lambda:psycopg.connect(DSN,row_factory=dict_row)):
    payload=AssetCardPresetQueryRequest(os_name='bunt',os_version_like='22.%')
    result=db.query_asset_card_preset('os-versions',os_name=payload.os_name,os_version_like=payload.os_version_like)
    assert result['total']==1 and result['rows'][0]['count']==103, result
    result=db.query_asset_card_preset_assets('os-versions',os_name='Ubuntu',os_version='22.04',offset=100)
    assert result['total']==103 and len(result['rows'])==3, result
    result=db.query_asset_card_preset_assets('os-versions',os_name='Ubuntu',os_version=None)
    assert [r['asset_id'] for r in result['rows']]==['unknown'], result
    result=db.query_asset_card_preset_assets('os-versions',os_name='Ubuntu',os_version='')
    assert [r['asset_id'] for r in result['rows']]==['empty'], result
    assert db.query_asset_card_preset('software-vendors',vendor='MICRO')['total']==1
    assert db.query_asset_card_preset('software-vendors',vendor='Other')['total']==0
print('PASS: PostgreSQL 16 OS search, exact version, null/empty groups, pagination (103 hosts), vendor substring/case filtering')
